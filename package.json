{
    "name": "cyberpunk2077",
    "version": "0.13.0",
    "description": "Cyberpunk 2077 modding support for the Vortex mod manager, as user-friendly and helpful as possible.",
    "homepage": "https://www.nexusmods.com/site/mods/196",
    "repository": "https://github.com/E1337Kat/cyberpunk2077_ext_redux",
    "bugs": "https://github.com/E1337Kat/cyberpunk2077_ext_redux/issues",
    "main": "./dist/index.js",
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "prepare": "husky install",
        "pre-commit": "lint-staged",
        "post-commit": "pnpm run pack-dev && pnpm run test",
        "postinstall": "patch-package",
        "clean": "rm *.7z && rm ./dist/*",
        "clear-caches": "jest --clearCache",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint -c .eslintrc.build.json src test",
        "lint-fix": "eslint -c .eslintrc.build.json --fix src test && prettier --write",
        "test": "jest --no-cache --verbose=true --silent=false",
        "test-debug": "jest --clearCache && node --inspect-brk ./node_modules/.bin/jest --runInBand --verbose=true --silent=false --no-cache",
        "_asset-copy": "extractInfo",
        "bundle": "node ./build.mjs",
        "build": "pnpm run bundle && pnpm run _asset-copy",
        "pack": "pnpm run test && pnpm run build && node ./script/package.mjs",
        "pack-dev": "pnpm run build && node ./script/package.mjs --dev",
        "dump-schemas": "ts-node -T ./script/dump-schemas.ts",
        "repl": "ts-node -r tsconfig-paths/register"
    },
    "author": "Black Tree Gaming Ltd.",
    "contributors": [
        "KellieAtTheLab",
        "Ellie (http://🍆💦🍑😩.ws//)",
        "Auska (https://github.com/effs)",
        "Bladehawke (https://github.com/Bladehawke)",
        "ThunderGod (https://github.com/thundergod97)"
    ],
    "license": "GPL-3.0",
    "devDependencies": {
        "@jest/types": "^27.5.1",
        "@nexusmods/vortex-api": "2.6.0-beta.1",
        "@types/glob": "^7.2.0",
        "@types/jest": "^27.4.1",
        "@types/jest-expect-message": "^1.0.3",
        "@types/mock-fs": "^4.13.1",
        "@types/node": "^17.0.21",
        "@types/react": "^17.0.0",
        "@types/react-bootstrap": "^0.32.20",
        "@types/react-dom": "^16.0.6",
        "@typescript-eslint/eslint-plugin": "^5.15.0",
        "@typescript-eslint/parser": "^5.15.0",
        "bluebird": "^3.7.2",
        "eslint": "^8.22.0",
        "eslint-config-airbnb-typescript": "^16.1.1",
        "eslint-plugin-import": "^2.25.4",
        "eslint-plugin-import-newlines": "^1.2.3",
        "glob": "^8.0.3",
        "husky": "^7.0.0",
        "i18next": "^21.0.0",
        "io-ts-schema": "^0.1.1",
        "jest": "^27.5.1",
        "jest-expect-message": "^1.0.2",
        "jest-mock-extended": "^2.0.4",
        "lint-staged": "^12.3.5",
        "mock-fs": "^5.5.0",
        "patch-package": "^6.4.7",
        "react": "^17.0.2",
        "react-bootstrap": "^2.2.1",
        "react-dom": "^17.0.2",
        "react-i18next": "^12.0.0",
        "react-redux": "^8.0.4",
        "redux": "4.2.1",
        "redux-act": "^1.8.0",
        "redux-thunk": "2.4.2",
        "rolldown": "1.1.4",
        "ts-jest": "^27.1.3",
        "ts-node": "^10.7.0",
        "tsconfig-paths": "^3.13.0",
        "typescript": "^4.8.4"
    },
    "dependencies": {
        "fp-ts": "^2.12.1",
        "io-ts": "^2.2.18",
        "key-tree": "^1.0.3",
        "monocle-ts": "^2.3.13",
        "spectacles-ts": "^1.0.7"
    }
}
